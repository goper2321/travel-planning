{
  "manifest_version": 3,
  "name": "Trip Planner",
  "version": "1.0",
  "description": "A browser extension that enhances Google Maps with trip-planning superpowers.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
